[node name="Texto" type="Label" parent="Margen/Col/Scroll/Cuerpo/Reglas/Tarjeta3/Fila/Textos"]
layout_mode = 2
text = "Si recoges otra celda a tiempo, el combo sube un nivel (máximo x5). Tienes 4 s en la Ronda 1, 3.5 s en la 2 y 3 s en la 3. Se reinicia si se acaba el tiempo o si pierdes una vida."
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
