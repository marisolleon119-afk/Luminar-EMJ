[node name="Texto" type="Label" parent="Margen/Col/Scroll/Cuerpo/Reglas/Tarjeta4/Fila/Textos"]
layout_mode = 2
text = "Acércate a un farol apagado y pulsa E o Espacio. Cuesta 10 de energía, da +50 puntos y crea una zona segura de luz. Al encender los 5 completas la ronda (+100 × número de ronda). En cada ronda los faroles cambian de lugar."
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
size_flags_horizontal = 3

