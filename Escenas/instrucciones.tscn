size_flags_horizontal = 3

[node name="Titulo" type="Label" parent="Margen/Col/Scroll/Cuerpo/Reglas/Tarjeta7/Fila/Textos"]
layout_mode = 2
text = "Rondas y tiempo"
theme_type_variation = &"Titulo"
theme_override_font_sizes/font_size = 19

[node name="Texto" type="Label" parent="Margen/Col/Scroll/Cuerpo/Reglas/Tarjeta7/Fila/Textos"]
layout_mode = 2
text = "Cada ronda trae más Sombras, más rápidas, que ven más lejos, y más oscuridad. Ganas +1 punto por segundo. Si te falta una vida, a veces aparece un corazón en el mapa: recógelo antes de que se apague para recuperarla. La partida termina al perder las 3 vidas, al pasar 6:00 o al completar la Ronda 3 (+500). Para el ranking en la nube entra con tu alias y un PIN de 4 números: así nadie más puede usar tu nombre, ni desde otra computadora."
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
size_flags_horizontal = 3

