[node name="Titulo" type="Label" parent="Margen/Col/Scroll/Cuerpo/Reglas/Tarjeta5/Fila/Textos"]
layout_mode = 2
text = "Energía"
theme_type_variation = &"Titulo"
theme_override_font_sizes/font_size = 19

[node name="Texto" type="Label" parent="Margen/Col/Scroll/Cuerpo/Reglas/Tarjeta5/Fila/Textos"]
layout_mode = 2
text = "Va de 0 a 100. Fuera de la luz gastas al moverte y, un poco menos, quieta; el gasto sube en cada ronda. Mantén Shift para correr más rápido a cambio de energía extra. Con 0 te mueves a la mitad de velocidad; si pasan 5 segundos así pierdes una vida."
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
size_flags_horizontal = 3

