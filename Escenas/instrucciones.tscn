text = "Sombras"
theme_type_variation = &"Titulo"
theme_override_font_sizes/font_size = 19

[node name="Texto" type="Label" parent="Margen/Col/Scroll/Cuerpo/Reglas/Tarjeta6/Fila/Textos"]
layout_mode = 2
text = "Te persiguen si te ven fuera de la luz y avisan a las Sombras cercanas. Cuanto más dura una ronda, más rápidas se vuelven, y en la Ronda 3 anticipan tus movimientos. La luz las frena y las disipa. Cuando una Sombra te ve aparece un \"!\" rojo sobre ella."
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
size_flags_horizontal = 3

