[node name="Texto" type="Label" parent="Margen/Col/Scroll/Cuerpo/Reglas/Tarjeta2/Fila/Textos"]
layout_mode = 2
text = "Las esferas doradas dan 10 puntos × combo y +15 de energía. Si la recoges lejos de la luz ganas +5 de bono de riesgo. En las rondas avanzadas aparecen menos celdas y más despacio."
theme_override_font_sizes/font_size = 15
