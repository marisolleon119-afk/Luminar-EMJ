[node name="SubConsejos" type="Label" parent="Interfaz/Ayuda/Centro/Panel/Col"]
layout_mode = 2
text = "Consejos"
theme_type_variation = &"Subtitulo"
theme_override_font_sizes/font_size = 20

[node name="Consejo0" type="Label" parent="Interfaz/Ayuda/Centro/Panel/Col"]
layout_mode = 2
text = "• Moverte fuera de la luz gasta energía (más en las rondas avanzadas). Dentro de la luz de un farol no se gasta."
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
custom_minimum_size = Vector2(620.0, 0.0)

[node name="Consejo1" type="Label" parent="Interfaz/Ayuda/Centro/Panel/Col"]
layout_mode = 2
text = "• Cada celda da 10 puntos × combo y 15 de energía. Fuera de la luz ganas +5 de riesgo."
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
custom_minimum_size = Vector2(620.0, 0.0)

[node name="Consejo2" type="Label" parent="Interfaz/Ayuda/Centro/Panel/Col"]
layout_mode = 2
text = "• El combo sube si recoges otra celda a tiempo (máximo x5). La ventana se acorta en cada ronda."
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
custom_minimum_size = Vector2(620.0, 0.0)

[node name="Consejo3" type="Label" parent="Interfaz/Ayuda/Centro/Panel/Col"]
layout_mode = 2
text = "• Encender un farol cuesta 10 de energía, da 50 puntos y crea una zona segura."
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
custom_minimum_size = Vector2(620.0, 0.0)

[node name="Consejo4" type="Label" parent="Interfaz/Ayuda/Centro/Panel/Col"]
layout_mode = 2
text = "• Si una Sombra te ve, avisa a las demás. Con el tiempo se vuelven más rápidas: no te quedes lejos de la luz."
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
custom_minimum_size = Vector2(620.0, 0.0)

[node name="Consejo5" type="Label" parent="Interfaz/Ayuda/Centro/Panel/Col"]
layout_mode = 2
text = "• Sin energía vas a la mitad de velocidad. Si pasas 5 segundos así, pierdes una vida."
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
custom_minimum_size = Vector2(620.0, 0.0)

[node name="BtnVolverAyuda" type="Button" parent="Interfaz/Ayuda/Centro/Panel/Col"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(0.0, 46.0)
