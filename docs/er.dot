digraph G {
  rankdir=LR; graph [fontname="DejaVu Sans", bgcolor="white", pad=0.5, ranksep=1.3, nodesep=0.6];
  node [fontname="DejaVu Sans", fontsize=12, shape=none]; edge [fontname="DejaVu Sans", fontsize=12];
  jug [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#2f9e44">
    <tr><td bgcolor="#2f9e44" colspan="2"><font color="white"><b>JUGADORES</b></font></td></tr>
    <tr><td align="left"><b>🔑 id_jugador</b></td><td align="left">uuid PK</td></tr>
    <tr><td align="left">alias</td><td align="left">text UNIQUE sin mayúsculas (3–12)</td></tr>
    <tr><td align="left">pin_hash</td><td align="left">text (bcrypt, no se lee por la API)</td></tr>
    <tr><td align="left">intentos_fallidos</td><td align="left">int</td></tr>
    <tr><td align="left">bloqueado_hasta</td><td align="left">timestamptz</td></tr>
    <tr><td align="left">fecha_registro</td><td align="left">timestamptz (servidor)</td></tr></table>>];
  par [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#3b5bdb">
    <tr><td bgcolor="#3b5bdb" colspan="2"><font color="white"><b>PARTIDAS</b></font></td></tr>
    <tr><td align="left"><b>🔑 id_partida</b></td><td align="left">uuid PK</td></tr>
    <tr><td align="left"><i>id_jugador</i></td><td align="left">uuid FK → JUGADORES</td></tr>
    <tr><td align="left">puntuacion</td><td align="left">int (0–99 999)</td></tr>
    <tr><td align="left">nivel_alcanzado</td><td align="left">smallint (1–3)</td></tr>
    <tr><td align="left">fecha_partida</td><td align="left">timestamptz (servidor)</td></tr>
    <tr><td align="left">celdas · faroles</td><td align="left">int</td></tr>
    <tr><td align="left">combo · tiempo</td><td align="left">int (1–5) · int (0–365 s)</td></tr></table>>];
  ses [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#e8590c">
    <tr><td bgcolor="#e8590c" colspan="2"><font color="white"><b>SESIONES</b></font></td></tr>
    <tr><td align="left"><b>🔑 token_hash</b></td><td align="left">text PK (sha256)</td></tr>
    <tr><td align="left"><i>id_jugador</i></td><td align="left">uuid FK → JUGADORES</td></tr>
    <tr><td align="left">creada</td><td align="left">timestamptz</td></tr></table>>];
  jug -> par [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  1 ─── N  \n  juega  "];
  jug -> ses [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  1 ─── N  \n  un dispositivo  "];
}
